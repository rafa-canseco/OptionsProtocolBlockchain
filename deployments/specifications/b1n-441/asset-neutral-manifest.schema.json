{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b1nary.example/schemas/asset-neutral-options-manifest-2.0.0.json",
  "title": "B1N asset-neutral options adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestId",
    "manifestRevision",
    "manifestContentIdentity",
    "supersedes",
    "status",
    "consumerReady",
    "activationAuthorized",
    "source",
    "identity",
    "assets",
    "abi",
    "deployment",
    "compatibility",
    "trustRules"
  ],
  "properties": {
    "$schema": {
      "const": "./asset-neutral-manifest.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "manifestRevision": {
      "type": "integer",
      "minimum": 1
    },
    "manifestContentIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "#/$defs/manifestPredecessor"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "PREDEPLOYMENT",
        "DEPLOYED"
      ]
    },
    "consumerReady": {
      "type": "boolean"
    },
    "activationAuthorized": {
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "abi": {
      "$ref": "#/$defs/abi"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "trustRules": {
      "$ref": "#/$defs/trustRules"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PREDEPLOYMENT"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "consumerReady": {
            "const": false
          },
          "manifestRevision": {
            "const": 1
          },
          "supersedes": {
            "type": "null"
          },
          "identity": {
            "properties": {
              "deploymentId": {
                "type": "null"
              }
            }
          },
          "assets": {
            "properties": {
              "underlying": {
                "properties": {
                  "symbol": {
                    "const": "LBTC"
                  },
                  "runtimeCodehash": {
                    "const": "0x599a6b80cccf2c7082103129c3725529a49d37b569dc0ecc031f0444b0ce0fff"
                  },
                  "address": {
                    "const": "0x39fA11EbBE82699Fd9F79C566D7384064571d2b4"
                  },
                  "decimals": {
                    "const": 8
                  },
                  "testAssetDisclosure": {
                    "$ref": "#/$defs/lbtcTestOnlyDisclosure"
                  }
                }
              },
              "settlement": {
                "properties": {
                  "runtimeCodehash": {
                    "type": "null"
                  },
                  "address": {
                    "type": "null"
                  },
                  "testAssetDisclosure": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "deployment": {
            "$ref": "#/$defs/predeployment"
          },
          "activationAuthorized": {
            "const": false
          },
          "source": {
            "properties": {
              "activationAuthorizationArtifact": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEPLOYED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "consumerReady": {
            "const": true
          },
          "manifestRevision": {
            "minimum": 2
          },
          "supersedes": {
            "$ref": "#/$defs/manifestPredecessor"
          },
          "identity": {
            "properties": {
              "deploymentId": {
                "$ref": "#/$defs/bytes32"
              }
            }
          },
          "assets": {
            "properties": {
              "underlying": {
                "properties": {
                  "runtimeCodehash": {
                    "$ref": "#/$defs/bytes32"
                  },
                  "address": {
                    "$ref": "#/$defs/address"
                  }
                }
              },
              "settlement": {
                "properties": {
                  "runtimeCodehash": {
                    "$ref": "#/$defs/bytes32"
                  },
                  "address": {
                    "$ref": "#/$defs/address"
                  }
                }
              }
            }
          },
          "deployment": {
            "$ref": "#/$defs/deployed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEPLOYED"
          },
          "activationAuthorized": {
            "const": true
          }
        },
        "required": [
          "status",
          "activationAuthorized"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "activationAuthorizationArtifact": {
                "$ref": "#/$defs/artifactPin"
              }
            },
            "required": [
              "activationAuthorizationArtifact"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifestPredecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "manifestRevision",
        "manifestContentIdentity"
      ],
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "manifestRevision": {
          "type": "integer",
          "minimum": 1
        },
        "manifestContentIdentity": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commits"
      ],
      "properties": {
        "status": {
          "enum": [
            "MERGED_ON_ORIGIN_STAGING",
            "NOT_PRESENT_ON_ORIGIN_STAGING"
          ]
        },
        "commits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originStagingCommit",
        "schema",
        "interfaceSources",
        "semanticValidator",
        "policyArtifact",
        "prerequisites",
        "activationAuthorizationArtifact"
      ],
      "properties": {
        "originStagingCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "schema": {
          "$ref": "#/$defs/artifactPin"
        },
        "interfaceSources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "wheel"
          ],
          "properties": {
            "adapter": {
              "$ref": "#/$defs/artifactPin"
            },
            "wheel": {
              "$ref": "#/$defs/artifactPin"
            }
          }
        },
        "semanticValidator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "scripts/validate-b1n-441-manifest.mjs"
            },
            "sha256": {
              "const": "sha256:cb48e43ef92bcd0981fad70b4ccd2c2f3e77e3fdfa7c2ff803f886cbdaa1b3d6"
            }
          }
        },
        "policyArtifact": {
          "$ref": "#/$defs/artifactPin"
        },
        "prerequisites": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "B1N-411",
            "B1N-419"
          ],
          "properties": {
            "B1N-411": {
              "$ref": "#/$defs/prerequisite"
            },
            "B1N-419": {
              "$ref": "#/$defs/prerequisite"
            }
          }
        },
        "activationAuthorizationArtifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactPin"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "chainName",
        "chainId",
        "interfaceFamily",
        "interfaceVersion",
        "policyHashAlgorithm",
        "policyHash"
      ],
      "properties": {
        "deploymentId": {
          "oneOf": [
            {
              "$ref": "#/$defs/bytes32"
            },
            {
              "type": "null"
            }
          ]
        },
        "chainName": {
          "const": "base-sepolia"
        },
        "chainId": {
          "const": 84532
        },
        "interfaceFamily": {
          "const": "b1nary.asset-neutral-options-v2"
        },
        "interfaceVersion": {
          "const": 2
        },
        "policyHashAlgorithm": {
          "const": "sha256"
        },
        "policyHash": {
          "$ref": "#/$defs/bytes32"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "address",
        "decimals",
        "decimalsTrust",
        "runtimeCodehash",
        "testAssetDisclosure"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "oneOf": [
            {
              "$ref": "#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "decimalsTrust": {
          "const": "MANIFEST_AND_LIVE_EXACT"
        },
        "runtimeCodehash": {
          "oneOf": [
            {
              "$ref": "#/$defs/bytes32"
            },
            {
              "type": "null"
            }
          ]
        },
        "testAssetDisclosure": {
          "oneOf": [
            {
              "$ref": "#/$defs/lbtcTestOnlyDisclosure"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "lbtcTestOnlyDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerLabel",
        "contractType",
        "backingClaim",
        "mintAccess",
        "networkScope"
      ],
      "properties": {
        "consumerLabel": {
          "const": "LBTC_TEST_ONLY"
        },
        "contractType": {
          "const": "VERIFIED_MOCK_ERC20"
        },
        "backingClaim": {
          "const": "NONE"
        },
        "mintAccess": {
          "const": "UNRESTRICTED_ANY_CALLER"
        },
        "networkScope": {
          "const": "BASE_SEPOLIA_ONLY"
        }
      }
    },
    "fixedUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "decimals"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "decimals": {
          "const": 8
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "underlying",
        "settlement",
        "oTokenUnit",
        "priceUnit",
        "supportedDecimalTuple"
      ],
      "properties": {
        "underlying": {
          "$ref": "#/$defs/asset"
        },
        "settlement": {
          "$ref": "#/$defs/asset"
        },
        "oTokenUnit": {
          "$ref": "#/$defs/fixedUnit"
        },
        "priceUnit": {
          "$ref": "#/$defs/fixedUnit"
        },
        "supportedDecimalTuple": {
          "type": "array",
          "prefixItems": [
            {
              "const": 8
            },
            {
              "enum": [
                8,
                18
              ]
            },
            {
              "const": 8
            },
            {
              "const": 6
            }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      },
      "oneOf": [
        {
          "properties": {
            "underlying": {
              "properties": {
                "decimals": {
                  "const": 8
                }
              },
              "required": [
                "decimals"
              ]
            },
            "settlement": {
              "properties": {
                "decimals": {
                  "const": 6
                }
              },
              "required": [
                "decimals"
              ]
            },
            "supportedDecimalTuple": {
              "prefixItems": [
                {
                  "const": 8
                },
                {
                  "const": 8
                },
                {
                  "const": 8
                },
                {
                  "const": 6
                }
              ]
            }
          }
        },
        {
          "properties": {
            "underlying": {
              "properties": {
                "decimals": {
                  "const": 18
                }
              },
              "required": [
                "decimals"
              ]
            },
            "settlement": {
              "properties": {
                "decimals": {
                  "const": 6
                }
              },
              "required": [
                "decimals"
              ]
            },
            "supportedDecimalTuple": {
              "prefixItems": [
                {
                  "const": 8
                },
                {
                  "const": 18
                },
                {
                  "const": 8
                },
                {
                  "const": 6
                }
              ]
            }
          }
        }
      ]
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "wheel",
        "openPositionDataEncoding",
        "deallocateDataEncoding"
      ],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractName",
            "artifact"
          ],
          "properties": {
            "contractName": {
              "const": "IAssetNeutralOptionsAdapterV2"
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "const": "deployments/specifications/b1n-441/IAssetNeutralOptionsAdapterV2.abi.json"
                },
                "sha256": {
                  "const": "sha256:e982066894cf68796dba26549f0d67503b550ad0bbdb939e19bfba4255fd9024"
                }
              }
            }
          }
        },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractName",
            "artifact"
          ],
          "properties": {
            "contractName": {
              "const": "IAssetNeutralWheelV2"
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "const": "deployments/specifications/b1n-441/IAssetNeutralWheelV2.abi.json"
                },
                "sha256": {
                  "const": "sha256:c180db95eab496c604fd3634b83d07ea18a4291e7de417f5bf9d39c7fa9f7868"
                }
              }
            }
          }
        },
        "openPositionDataEncoding": {
          "const": "((address,uint256,uint256,uint256,uint256,uint256),bytes,uint256,uint256)"
        },
        "deallocateDataEncoding": {
          "const": "(uint8,uint256,uint256,uint256)"
        }
      }
    },
    "contractIdentity": {
      "oneOf": [
        {
          "$ref": "#/$defs/proxyContract"
        },
        {
          "$ref": "#/$defs/immutableContract"
        }
      ]
    },
    "proxyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "address",
        "proxyRuntimeCodehash",
        "implementation",
        "implementationRuntimeCodehash",
        "codeIdentity",
        "interfaceRole",
        "interfaceContractName",
        "abiArtifact",
        "interfaceVersion",
        "validFromBlock"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "PROXY"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "proxyRuntimeCodehash": {
          "$ref": "#/$defs/bytes32"
        },
        "implementation": {
          "$ref": "#/$defs/address"
        },
        "implementationRuntimeCodehash": {
          "$ref": "#/$defs/bytes32"
        },
        "codeIdentity": {
          "$ref": "#/$defs/bytes32"
        },
        "interfaceVersion": {
          "const": 2
        },
        "validFromBlock": {
          "type": "integer",
          "minimum": 1
        },
        "interfaceRole": {
          "enum": [
            "OPTIONS_ADAPTER",
            "WHEEL_COORDINATOR"
          ]
        },
        "interfaceContractName": {
          "enum": [
            "IAssetNeutralOptionsAdapterV2",
            "IAssetNeutralWheelV2"
          ]
        },
        "abiArtifact": {
          "$ref": "#/$defs/artifactPin"
        }
      },
      "oneOf": [
        {
          "properties": {
            "interfaceRole": {
              "const": "OPTIONS_ADAPTER"
            },
            "interfaceContractName": {
              "const": "IAssetNeutralOptionsAdapterV2"
            },
            "abiArtifact": {
              "properties": {
                "path": {
                  "const": "deployments/specifications/b1n-441/IAssetNeutralOptionsAdapterV2.abi.json"
                },
                "sha256": {
                  "const": "sha256:e982066894cf68796dba26549f0d67503b550ad0bbdb939e19bfba4255fd9024"
                }
              }
            }
          }
        },
        {
          "properties": {
            "interfaceRole": {
              "const": "WHEEL_COORDINATOR"
            },
            "interfaceContractName": {
              "const": "IAssetNeutralWheelV2"
            },
            "abiArtifact": {
              "properties": {
                "path": {
                  "const": "deployments/specifications/b1n-441/IAssetNeutralWheelV2.abi.json"
                },
                "sha256": {
                  "const": "sha256:c180db95eab496c604fd3634b83d07ea18a4291e7de417f5bf9d39c7fa9f7868"
                }
              }
            }
          }
        }
      ]
    },
    "immutableContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "address",
        "runtimeCodehash",
        "codeIdentity",
        "interfaceRole",
        "interfaceContractName",
        "abiArtifact",
        "interfaceVersion",
        "validFromBlock"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "IMMUTABLE"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "runtimeCodehash": {
          "$ref": "#/$defs/bytes32"
        },
        "codeIdentity": {
          "$ref": "#/$defs/bytes32"
        },
        "interfaceVersion": {
          "const": 2
        },
        "validFromBlock": {
          "type": "integer",
          "minimum": 1
        },
        "interfaceRole": {
          "enum": [
            "OPTIONS_ADAPTER",
            "WHEEL_COORDINATOR"
          ]
        },
        "interfaceContractName": {
          "enum": [
            "IAssetNeutralOptionsAdapterV2",
            "IAssetNeutralWheelV2"
          ]
        },
        "abiArtifact": {
          "$ref": "#/$defs/artifactPin"
        }
      },
      "oneOf": [
        {
          "properties": {
            "interfaceRole": {
              "const": "OPTIONS_ADAPTER"
            },
            "interfaceContractName": {
              "const": "IAssetNeutralOptionsAdapterV2"
            },
            "abiArtifact": {
              "properties": {
                "path": {
                  "const": "deployments/specifications/b1n-441/IAssetNeutralOptionsAdapterV2.abi.json"
                },
                "sha256": {
                  "const": "sha256:e982066894cf68796dba26549f0d67503b550ad0bbdb939e19bfba4255fd9024"
                }
              }
            }
          }
        },
        {
          "properties": {
            "interfaceRole": {
              "const": "WHEEL_COORDINATOR"
            },
            "interfaceContractName": {
              "const": "IAssetNeutralWheelV2"
            },
            "abiArtifact": {
              "properties": {
                "path": {
                  "const": "deployments/specifications/b1n-441/IAssetNeutralWheelV2.abi.json"
                },
                "sha256": {
                  "const": "sha256:c180db95eab496c604fd3634b83d07ea18a4291e7de417f5bf9d39c7fa9f7868"
                }
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionHash",
        "blockNumber",
        "blockHash",
        "status"
      ],
      "properties": {
        "transactionHash": {
          "$ref": "#/$defs/bytes32"
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 1
        },
        "blockHash": {
          "$ref": "#/$defs/bytes32"
        },
        "status": {
          "const": 1
        }
      }
    },
    "deployment": {
      "oneOf": [
        {
          "$ref": "#/$defs/predeployment"
        },
        {
          "$ref": "#/$defs/deployed"
        }
      ]
    },
    "predeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "validFromBlock",
        "contracts",
        "canonicalReceipts"
      ],
      "properties": {
        "deploymentId": {
          "type": "null"
        },
        "validFromBlock": {
          "type": "null"
        },
        "contracts": {
          "type": "array",
          "maxItems": 0
        },
        "canonicalReceipts": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "deployed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "validFromBlock",
        "contracts",
        "canonicalReceipts"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "#/$defs/bytes32"
        },
        "validFromBlock": {
          "type": "integer",
          "minimum": 1
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
